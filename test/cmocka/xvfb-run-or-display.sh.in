#!/bin/sh
# Stand-in for xvfb-run in the cmocka tests' add_test commands (configured by
# test/cmocka/CMakeLists.txt): run the test on the X display it already has
# (validate.sh runs all of ctest under one xvfb-run), and start a private
# Xvfb only when there is none. Each test starting its own `xvfb-run -a`
# raced the others for a display number under ctest -j: two at once picked
# the same one, and the loser's obs_startup failed with "Unable to open X
# display".
#   xvfb-run-or-display [-a] <command> [args...]
if [ "$1" = "-a" ]; then
  shift
fi
if [ -n "${DISPLAY:-}" ]; then
  exec "$@"
fi
exec "@OBS_XVFB_RUN_REAL@" -a "$@"
