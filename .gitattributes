* text=auto

# Keep raw shader resources identical across host checkouts and archives.
*.effect text eol=lf

*.sln             text eol=crlf
*.vcproj          text eol=crlf
*.vcxproj         text eol=crlf
*.vcxproj         text eol=crlf
*.vcxproj.filters text eol=crlf

cmake/ALL_BUILD.vcxproj.user.in text eol=crlf

# Governance files: keep this fork's version when merging from upstream
# (Constitution of the obs-rust Project). Requires once per clone:
#   git config merge.ours.driver true
CONTRIBUTING.md merge=ours
README.md merge=ours
CONSTITUTION.md merge=ours
