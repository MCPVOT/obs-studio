# macOS capture inventories shared by CMake and Cargo/obs-build.
include_guard(GLOBAL)

function(obs_macos_capture_sources output name base)
  set(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../..")
  set(_manifest "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/source-sets.json")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
  file(READ "${_manifest}" _sets)
  string(JSON _count LENGTH "${_sets}" "${name}")
  math(EXPR _last "${_count} - 1")
  set(_sources "")
  foreach(_index RANGE ${_last})
    string(JSON _source GET "${_sets}" "${name}" ${_index})
    get_filename_component(_source "${_root}/${_source}" ABSOLUTE)
    file(RELATIVE_PATH _source "${base}" "${_source}")
    list(APPEND _sources "${_source}")
  endforeach()
  set(${output} "${_sources}" PARENT_SCOPE)
endfunction()
