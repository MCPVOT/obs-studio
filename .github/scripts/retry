#!/bin/sh
# Run a command, retrying it with backoff when it fails (network downloads
# such as `brew install`; obs-rust/obs-studio#634).
#   .github/scripts/retry brew install --quiet zsh
# RETRY_ATTEMPTS (default 3) and RETRY_DELAY (seconds, default 15, doubled
# after each failure) tune it. Exits with the last attempt's status.
attempts=${RETRY_ATTEMPTS:-3}
delay=${RETRY_DELAY:-15}
n=1
while :; do
  "$@" && exit 0
  status=$?
  echo "retry: '$*' failed with status $status (attempt $n/$attempts)" >&2
  [ "$n" -ge "$attempts" ] && exit "$status"
  sleep "$delay"
  delay=$((delay * 2))
  n=$((n + 1))
done
